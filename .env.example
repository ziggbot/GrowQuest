# Copy to .env and fill in. .env is gitignored.
# Get these from `supabase start` output (local) or Supabase dashboard (cloud).

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key — used ONLY by edge functions and CI migrations.
# Never embedded in the iOS app. Leave blank locally; set as a GitHub Action secret.
# SUPABASE_SERVICE_ROLE_KEY=
